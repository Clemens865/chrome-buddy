# Chrome Buddy — environment (DEVELOPMENT ONLY)
#
# Copy to `.env` and fill in to run with a key without entering it in Settings.
# WARNING: this value is read by Vite at BUILD TIME and inlined into the bundle
# (dist/assets/*.js). It is visible to anyone with the build. NEVER commit a real
# key, and NEVER publish a Web Store build that was built with a key set here.
# Production users enter their own key in Settings (kept in chrome.storage.local).
#
# `.env` is gitignored. The in-app key always takes precedence over this fallback.

VITE_GEMINI_API_KEY=
