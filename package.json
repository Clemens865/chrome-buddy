{
  "name": "chrome-buddy",
  "version": "0.1.0",
  "description": "Universal agentic + LLM Chrome extension — model-transparent, BYO-key, privacy-respecting.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.content.config.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test smoke.spec.ts",
    "test:e2e:live": "playwright test live-chat.spec.ts",
    "test:e2e:complex": "playwright test complex.spec.ts",
    "test:e2e:workflows": "playwright test workflows.spec.ts",
    "test:e2e:callskill": "playwright test call-skill.spec.ts",
    "test:e2e:clicktype": "playwright test click-type.spec.ts",
    "test:e2e:modelpicker": "playwright test model-picker.spec.ts",
    "test:e2e:voice": "playwright test voice.spec.ts",
    "test:e2e:triggers": "playwright test workflow-triggers.spec.ts",
    "test:e2e:filewrite": "playwright test file-write.spec.ts",
    "test:e2e:recall": "playwright test recall.spec.ts",
    "test:e2e:appgen": "playwright test app-generator.spec.ts",
    "test:e2e:sandbox": "playwright test sandbox.spec.ts",
    "test:e2e:rootfolder": "playwright test root-folder.spec.ts",
    "test:e2e:keycustody": "playwright test key-custody.spec.ts",
    "test:e2e:cost": "playwright test cost.spec.ts",
    "test:e2e:budget": "playwright test budget.spec.ts",
    "test:e2e:onboarding": "playwright test onboarding.spec.ts",
    "test:e2e:plangate": "playwright test plan-gate.spec.ts",
    "test:e2e:askuser": "playwright test ask-user.spec.ts",
    "test:e2e:humangate": "playwright test human-gate.spec.ts",
    "test:e2e:cdp": "playwright test cdp-trusted.spec.ts",
    "test:e2e:console": "playwright test console-inspector.spec.ts",
    "test:e2e:appsgrid": "playwright test apps-grid.spec.ts",
    "test:e2e:transcriber": "playwright test transcriber.spec.ts",
    "test:e2e:resume": "playwright test resume.spec.ts",
    "test:e2e:vision": "playwright test vision.spec.ts",
    "test:e2e:skillseditor": "playwright test skills-editor.spec.ts",
    "test:e2e:wfeditor": "playwright test workflow-editor.spec.ts",
    "test:e2e:registry": "playwright test model-registry.spec.ts",
    "test:e2e:tier2bridge": "playwright test tier2-bridge.spec.ts",
    "test:e2e:nano": "playwright test nano.spec.ts",
    "test:e2e:chathistory": "playwright test chat-history.spec.ts",
    "test:e2e:rootlive": "playwright test root-folder-live.spec.ts",
    "test:e2e:search": "playwright test search-citations.spec.ts",
    "test:e2e:fetchurl": "playwright test fetch-url.spec.ts",
    "test:e2e:notes": "playwright test notes.spec.ts",
    "test:e2e:vision": "playwright test vision-mode.spec.ts",
    "test:e2e:history": "playwright test history-detail.spec.ts",
    "test:e2e:stream": "playwright test chat-stream.spec.ts",
    "test:e2e:filesearch": "playwright test file-search-stores.spec.ts"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.19.19",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.8.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.4",
    "vite": "^6.0.0",
    "vitest": "^2.1.9"
  }
}
