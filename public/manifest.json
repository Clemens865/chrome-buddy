{
  "manifest_version": 3,
  "name": "Chrome Buddy",
  "version": "0.1.0",
  "description": "Universal agentic + LLM browser assistant — model-transparent, BYO-key, privacy-respecting.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "tabs", "activeTab", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Chrome Buddy"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["assets/overlay.js"],
      "run_at": "document_idle"
    }
  ]
}
